{
  "name": "bunker-disco",
  "version": "1.0.0",
  "description": "Jackbox-style PC version of Bunker board game with 3D voxel graphics and CQRS-lite architecture",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "seed": "npm run --workspace=@bunker/shared seed",
    "test:e2e": "vitest run --config tests/e2e/vitest.e2e.config.ts tests/e2e",
    "test:e2e:tier1": "vitest run --config tests/e2e/vitest.e2e.config.ts tests/e2e/tier1_features",
    "test:e2e:tier2": "vitest run --config tests/e2e/vitest.e2e.config.ts tests/e2e/tier2_boundaries",
    "test:e2e:tier3": "vitest run --config tests/e2e/vitest.e2e.config.ts tests/e2e/tier3_combinations",
    "test:e2e:tier4": "vitest run --config tests/e2e/vitest.e2e.config.ts tests/e2e/tier4_real_world"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
